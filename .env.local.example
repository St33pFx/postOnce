# DEV ONLY. Never use these credentials in production. Google OAuth is optional.
POSTONCE_DEV_LOGIN=1
POSTONCE_DEV_PROVIDERS=1
DATABASE_URL=postgresql://postonce:local_only@127.0.0.1:5432/postonce
DATABASE_SSL=disable
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=local-development-secret-change-me-32-chars
TOKEN_ENCRYPTION_KEYS={"k1":"cG9zdG9uY2UtbG9jYWwtdG9rZW4ta2V5LTMyYnl0ZXM="}
TOKEN_ACTIVE_KEY_VERSION=k1
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_BUCKET=postonce-local
S3_ACCESS_KEY_ID=postonce-local
S3_SECRET_ACCESS_KEY=postonce-local-secret
S3_FORCE_PATH_STYLE=true
# SeaweedFS uses authenticated private access; it does not implement AWS's block API.
S3_ENFORCE_PUBLIC_ACCESS_BLOCK=false
