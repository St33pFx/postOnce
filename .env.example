# Production template. Supply secrets through the hosting platform, never Git.
NODE_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postonce
DATABASE_SSL=verify-full
BETTER_AUTH_URL=https://postonce.example.com
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Version -> base64-encoded random 32-byte AES key.
TOKEN_ENCRYPTION_KEYS=
TOKEN_ACTIVE_KEY_VERSION=k1
# Managed private S3-compatible storage. For Cloudflare R2 use the account endpoint and region auto.
S3_ENDPOINT=https://s3.example-provider.com
S3_REGION=auto
S3_BUCKET=postonce-production
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_ENFORCE_PUBLIC_ACCESS_BLOCK=true
# Pin after verifying the supported Meta Graph API version for the production app.
INSTAGRAM_GRAPH_VERSION=v23.0
# Platform OAuth application configuration used by the connection service.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_OAUTH_REDIRECT_URI=https://postonce.example.com/api/connections/instagram/callback
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_OAUTH_REDIRECT_URI=https://postonce.example.com/api/connections/tiktok/callback
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_OAUTH_REDIRECT_URI=https://postonce.example.com/api/connections/youtube/callback
# Separate bounded media processor service.
MEDIA_SERVICE_URL=https://postonce-media.internal
MEDIA_SERVICE_SECRET=
