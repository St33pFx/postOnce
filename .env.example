# Local PostgreSQL only. Never use these example credentials in production.
DATABASE_URL=postgresql://postonce:local_only@localhost:5432/postonce
# Development defaults to disabled; production requires verify-full.
DATABASE_SSL=disable

# Google login only; these credentials must never be reused as YouTube grants.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# JSON object of version -> base64-encoded 32-byte random key. Kept outside DB/Git.
TOKEN_ENCRYPTION_KEYS=
TOKEN_ACTIVE_KEY_VERSION=k1
